# Copie para .env e ajuste. NÃO versione o .env.
# Hostname ao qual as passkeys ficam vinculadas (sem protocolo/porta)
RP_ID=localhost
# URL completa de onde o app é servido (deve casar com RP_ID; HTTPS fora de localhost)
ORIGIN=http://localhost:8080
# Porta do host para a interface web
WEB_PORT=8080
# Nome exibido no prompt da passkey
RP_NAME=AVADESK
# IDs de usuários com painel admin (separados por vírgula). Vazio = sem admin.
ADMIN_UIDS=
# Exigir código de convite para criar perfil (true/false)
INVITE_ONLY=false
# Duração da sessão em dias (padrão 90)
SESSION_DAYS=90
# Assunto VAPID para push (padrão: ORIGIN em HTTPS, senão mailto:admin@localhost)
# VAPID_SUBJECT=mailto:voce@exemplo.com