# Copie para .env e preencha. Nunca versione o .env.
PORT=8787
DATA_DIR=./data
ORIGIN=http://localhost:5551
CSRF_ALLOWED_ORIGINS=http://127.0.0.1:5551

# Cobrança. Simulador é o padrão seguro. Nunca coloque credenciais reais no Git.
BILLING_PROVIDER=simulado
# Para novas cobranças por checkout hospedado: BILLING_PROVIDER=infinitepay
INFINITEPAY_API_KEY=
INFINITEPAY_HANDLE=
ASAAS_ENV=sandbox
REQUIRE_LEGAL_CONFIG=false
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
RP_ID=localhost
RP_NAME=AVAGYM

# Identificacao legal inicial. O que for salvo em Dados da empresa tem prioridade.
# Deixe vazio ate ter os dados oficiais do ambiente.
COMPANY_LEGAL_NAME=
COMPANY_TRADE_NAME=
COMPANY_CNPJ=
COMPANY_PIX_KEY=
COMPANY_ADDRESS=
COMPANY_SUPPORT_EMAIL=
COMPANY_DPO_EMAIL=
COMPANY_FINANCE_EMAIL=
COMPANY_MODERATION_EMAIL=
COMPANY_CANCELLATION_URL=
COMPANY_JURISDICTION=
COMPANY_HOSTING_COUNTRY=
COMPANY_DOCUMENT_VERSION=1.1
COMPANY_DOCUMENT_EFFECTIVE_DATE=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=avagym
DB_USER=postgres
DB_PASSWORD=

# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_HOURS=168
DEFAULT_TENANT=avadesk
ADMIN_EMAIL=
# ADMIN_PASSWORD= (opcional; se vazio o migrate gera uma)

# E-mails transacionais: chave privada somente na API. Reinicie a API após configurar.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=
EMAIL_PREVIEW_RECIPIENT=
# ORIGIN acima é o endereço público real do aplicativo, usado nos links.
# SMTP legado opcional: EMAIL_PROVIDER=smtp; requer nodemailer instalado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# cópia de todo arquivo LGPD enviado (ex.: e-mail do encarregado de dados)
LGPD_COPY_EMAIL=
# segurança: interface de escuta (produção atrás de gateway/túnel: 127.0.0.1)
HOST=127.0.0.1
# RATE_LIMIT=off desliga o limite de tentativas em login/cadastro/recuperação (só para testes locais)
RATE_LIMIT=

# Midia privada (fotos e videos corporais da avaliacao postural).
# local = disco no DATA_DIR, padrao em desenvolvimento e nos testes (nada depende de rede).
# r2 = Cloudflare R2. Um bucket so, privado: sem dominio personalizado e sem URL publica de desenvolvimento.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=
# token "Object Read & Write" restrito ao bucket (R2 > Manage API Tokens). Nunca versione estes valores.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# segundos de validade da URL temporaria de midia corporal: o minimo que o player precisa
R2_MEDIA_URL_TTL=120
# assina as URLs internas de midia privada; se vazio usa o JWT_SECRET
STORAGE_SIGNING_SECRET=
# POSTURAL_RECURRENCE=off desliga a geracao automatica das avaliacoes recorrentes
POSTURAL_RECURRENCE=

# Testes locais. Nunca reutilize credenciais de desenvolvimento em producao.
E2E_PASSWORD=
E2E_EMAIL_DOMAIN=
SIM_WEBHOOK_TOKEN=
ACTOR_EMAIL=
