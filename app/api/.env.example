# Copie para .env e preencha. Nunca versione o .env.
PORT=8787
DATA_DIR=./data
ORIGIN=http://localhost:4449

# Cobrança. Simulador é o padrão seguro. Nunca coloque credenciais reais no Git.
BILLING_PROVIDER=simulado
# Para novas cobranças por checkout hospedado: BILLING_PROVIDER=infinitepay
INFINITEPAY_API_KEY=
INFINITEPAY_HANDLE=
ASAAS_ENV=sandbox
REQUIRE_LEGAL_CONFIG=false
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
RP_ID=localhost
RP_NAME=AVAGYM

DB_HOST=localhost
DB_PORT=5432
DB_NAME=avagym
DB_USER=postgres
DB_PASSWORD=

# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_HOURS=168
DEFAULT_TENANT=avadesk
ADMIN_EMAIL=admin@avagym.local
# ADMIN_PASSWORD= (opcional; se vazio o migrate gera uma)

# E-mails transacionais: chave privada somente na API. Reinicie a API após configurar.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=AVAGYM <avagym@avadesk.com.br>
# ORIGIN acima é o endereço público real do aplicativo, usado nos links.
# SMTP legado opcional: EMAIL_PROVIDER=smtp; requer nodemailer instalado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# cópia de todo arquivo LGPD enviado (ex.: e-mail do encarregado de dados)
LGPD_COPY_EMAIL=
# segurança: interface de escuta (produção atrás de gateway/túnel: 127.0.0.1)
HOST=127.0.0.1
# RATE_LIMIT=off desliga o limite de tentativas em login/cadastro/recuperação (só para testes locais)
RATE_LIMIT=
